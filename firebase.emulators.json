{
 "hosting": {
  "public": "public",
  "ignore": [
   "firebase.json",
   "**/.*",
   "**/node_modules/**"
  ],
  "headers": [
   {
    "source": "**/*.html",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "/",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "/talents/**",
    "headers": [
     {
      "key": "Access-Control-Allow-Origin",
      "value": "*"
     },
     {
      "key": "Cache-Control",
      "value": "public, max-age=3600"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules"
 },
 "auth": {},
 "emulators": {
  "auth": {
   "port": 9099,
   "host": "127.0.0.1"
  },
  "firestore": {
   "port": 8080,
   "host": "127.0.0.1"
  },
  "ui": {
   "enabled": false
  }
 }
}